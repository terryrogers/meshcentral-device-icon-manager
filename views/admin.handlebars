<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Device Icon Manager</title>
    <link rel="stylesheet" href="/pluginadmin.ashx?pin=deviceiconmanager&amp;include=1&amp;path=admin.css">
</head>
<body>
    <main>
        <header>
            <div>
                <h1>Device Icon Manager</h1>
                <p>Upload additional MeshCentral device icons using IDs 9 through 255.</p>
            </div>
            <span class="version">v{{pluginVersion}}</span>
        </header>

        <section class="panel upload-panel">
            <h2>Add or replace an icon</h2>
            <div class="form-grid">
                <label>
                    Name
                    <input id="iconName" type="text" maxlength="64" placeholder="e.g. Network switch">
                </label>
                <label>
                    Icon ID
                    <select id="iconId"><option value="auto">Next available automatically</option></select>
                </label>
                <label class="file-field">
                    PNG image
                    <input id="iconFile" type="file" accept="image/png,.png">
                </label>
                <div class="preview-box">
                    <canvas id="iconPreview" width="128" height="128" aria-label="Icon preview"></canvas>
                </div>
            </div>
            <p class="hint">The image is fitted onto a transparent square and normalised to safe 256×256 and 128×128 PNG files before upload.</p>
            <button id="uploadButton" type="button">Save icon</button>
        </section>

        <div id="status" role="status" aria-live="polite"></div>

        <section class="panel">
            <div class="section-heading">
                <div>
                    <h2>Custom icons</h2>
                    <p id="capacity">Loading catalogue…</p>
                </div>
                <button id="refreshButton" class="secondary" type="button">Refresh</button>
            </div>
            <div id="emptyState" class="empty">No custom device icons have been uploaded.</div>
            <div id="iconGrid" class="icon-grid"></div>
        </section>
    </main>
    <script src="/pluginadmin.ashx?pin=deviceiconmanager&amp;include=1&amp;path=admin.js"></script>
</body>
</html>
